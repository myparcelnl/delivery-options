{
  "name": "@myparcel-dev/delivery-options",
  "version": "7.5.9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myparcelnl/delivery-options.git",
    "directory": "apps/delivery-options"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./lib": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.lib.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.lib.cjs"
      }
    },
    "./*.css": "./dist/*.css"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "./dist"
  ],
  "scripts": {
    "build": "pnpm run build:default && pnpm run build:default:lib && pnpm run build:myparcel && pnpm run build:myparcel-lib",
    "build:default": "vite build",
    "build:default:dev": "pnpm run build:default --mode development",
    "build:default:lib": "BUILD_MODE=lib vite build",
    "build:default:lib:dev": "pnpm run build:default --mode development",
    "build:dev": "pnpm run build:default:dev && pnpm run build:myparcel:dev && pnpm run build:myparcel-lib:dev",
    "build:myparcel": "vite build -c vite-myparcel.config.ts",
    "build:myparcel:dev": "BUILD_CSS=1 pnpm run build:myparcel --mode development",
    "build:myparcel-lib": "vite build -c vite-myparcel-lib.config.ts",
    "build:myparcel-lib:dev": "BUILD_CSS=1 pnpm run build:myparcel-lib --mode development",
    "serve": "vite",
    "typecheck": "vue-tsc --project tsconfig.base.json --noEmit",
    "watch:myparcel": "BUILD_CSS=1 vite build -c vite-myparcel.config.ts --watch --mode development",
    "watch:myparcel-lib": "BUILD_CSS=1 vite build -c vite-myparcel-lib.config.ts --watch --mode development"
  },
  "dependencies": {
    "@myparcel-dev/constants": "^2.10.0",
    "@myparcel-dev/do-shared": "workspace:^",
    "@myparcel-dev/sdk": "^5.0.0",
    "@myparcel-dev/ts-utils": "^1.15.0",
    "@vueuse/core": "^10.0.0",
    "leaflet": "^1.9.4",
    "radash": "^12.0.0",
    "vue": "^3.5.26"
  },
  "devDependencies": {
    "@codecov/vite-plugin": "^2.0.1",
    "@myparcel-dev/do-build-vite": "workspace:^",
    "@myparcel-dev/do-semantic-release-plugin": "workspace:^",
    "@myparcel-dev/semantic-release-config": "^7.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@testing-library/vue": "^8.0.1",
    "@types/is-ci": "^3.0.0",
    "@types/leaflet": "^1.9.4",
    "@types/semver": "^7",
    "@vue/test-utils": "^2.4.0",
    "ci-info": "^4.0.0",
    "cssnano": "^8.0.2",
    "date-fns": "^3.0.0",
    "happy-dom": "^21.0.4",
    "pinia": "^2.1.7",
    "postcss": "^8.0.0",
    "postcss-replace": "2.0.1",
    "semantic-release": "^25.0.9",
    "semantic-release-monorepo": "^8.0.1",
    "semver": "^7.6.0",
    "tailwindcss": "^3.0.0",
    "typescript": "5.9.3",
    "vite": "^7.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^4.0.17",
    "vue-tsc": "^3.2.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "targets": {
      "clean": {},
      "lint": {},
      "lint:fix": {},
      "test": {},
      "test:coverage": {},
      "test:run": {},
      "test:update": {}
    }
  }
}
